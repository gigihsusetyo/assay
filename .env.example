# Assay configuration
# Default: SQLite for local development
ASSAY_DATABASE_URL=sqlite:///./assay.db

# For production, use PostgreSQL:
# ASSAY_DATABASE_URL=postgresql+psycopg://assay:assay@localhost:5432/assay

ASSAY_LOG_LEVEL=INFO

# LLM-as-judge (BYOK — Bring Your Own Key)
# Set these to enable LLM-based evaluation. If not set, Assay falls back
# to simple heuristic metrics.
#
# Groq (recommended, 14,400 requests/day free):
# ASSAY_JUDGE_PROVIDER=groq
# ASSAY_JUDGE_MODEL=openai/gpt-oss-120b
# ASSAY_JUDGE_API_KEY=gsk_...
# ASSAY_JUDGE_BASE_URL=https://api.groq.com/openai/v1
#
# OpenRouter (free tier: 50 requests/day):
# ASSAY_JUDGE_PROVIDER=openrouter
# ASSAY_JUDGE_MODEL=openrouter/free
# ASSAY_JUDGE_API_KEY=sk-or-...
# ASSAY_JUDGE_BASE_URL=https://openrouter.ai/api/v1
#
# OpenAI:
# ASSAY_JUDGE_PROVIDER=openai
# ASSAY_JUDGE_MODEL=gpt-4o-mini
# ASSAY_JUDGE_API_KEY=sk-...
# ASSAY_JUDGE_BASE_URL=https://api.openai.com/v1
#
# Ollama (local):
# ASSAY_JUDGE_PROVIDER=ollama
# ASSAY_JUDGE_MODEL=llama3.1
# ASSAY_JUDGE_API_KEY=ollama
# ASSAY_JUDGE_BASE_URL=http://localhost:11434/v1
